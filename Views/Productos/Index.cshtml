@model IEnumerable<SistemaFacturacion.Models.Producto>

@{
    ViewData["Title"] = "Productos";
}

<h1>Productos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Nuevo Producto
    </a>
</p>

<form asp-action="Index" method="get" class="mb-4">

    <div class="row">

        <div class="col-md-3">
            <label class="form-label">Estado</label>

            <select name="filtroEstado" class="form-select">

                @if (ViewBag.FiltroEstado == "Activos")
                {
                    <option value="Activos" selected>Activos</option>
                }
                else
                {
                    <option value="Activos">Activos</option>
                }

                @if (ViewBag.FiltroEstado == "Inactivos")
                {
                    <option value="Inactivos" selected>Inactivos</option>
                }
                else
                {
                    <option value="Inactivos">Inactivos</option>
                }

                @if (ViewBag.FiltroEstado == "Todos")
                {
                    <option value="Todos" selected>Todos</option>
                }
                else
                {
                    <option value="Todos">Todos</option>
                }

            </select>
        </div>

        <div class="col-md-5">

            <label class="form-label">
                Buscar producto
            </label>

            <input type="text"
                   name="buscar"
                   value="@ViewBag.Buscar"
                   class="form-control"
                   placeholder="Código o descripción..." />

        </div>

        <div class="col-md-4 d-flex align-items-end">

            <button type="submit"
                    class="btn btn-primary me-2">
                Buscar
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Limpiar
            </a>

        </div>

    </div>

</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                Código
            </th>
            <th>
                Descripción
            </th>
            <th>
                Precio
            </th>
            <th>
                IVA
            </th>
            <th>
                Estado
            </th>
            <th>
                Acciones
            </th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Codigo
                </td>

                <td>
                    @item.Descripcion
                </td>

                <td>
                    @item.Precio.ToString("N2")
                </td>

                <td>
                    @item.IVA.ToString("N2") %
                </td>

                <td>
                    @if (item.Activo == true)
                    {
                        <span class="text-success">
                            Activo
                        </span>
                    }
                    else
                    {
                        <span class="text-danger">
                            Inactivo
                        </span>
                    }
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-warning">
                        Editar
                    </a>

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-info">
                        Detalles
                    </a>

                    @if (item.Activo == true)
                    {
                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-danger">
                            Dar de baja
                        </a>
                    }
                    else
                    {
                        <a asp-action="Activar"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-success">
                            Dar de alta
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>